diff --git a/app/src/test/java/com/termux/app/terminal/io/FullTranscriptCopyQueueTest.java b/app/src/test/java/com/termux/app/terminal/io/FullTranscriptCopyQueueTest.java
new file mode 100644
index 0000000..53b3f81
--- /dev/null
+++ b/app/src/test/java/com/termux/app/terminal/io/FullTranscriptCopyQueueTest.java
@@ -0,0 +1,60 @@
+package com.termux.app.terminal.io;
+
+import org.junit.Test;
+
+import java.util.Arrays;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+public class FullTranscriptCopyQueueTest {
+
+    @Test
+    public void longTranscriptReassemblesInOrderWithoutLosingCharacters() {
+        String transcript = repeated('a', 18_900) + "\n"
+            + repeated('b', 19_000) + "\n" + repeated('c', 6_388);
+        FullTranscriptCopyQueue queue = new FullTranscriptCopyQueue(transcript);
+
+        assertEquals(44_290, transcript.length());
+        assertEquals(3, queue.partCount());
+        assertTrue(queue.currentPart().endsWith("\n"));
+        StringBuilder pasted = new StringBuilder();
+        for (int part = 1; part <= 3; part++) {
+            assertEquals(part, queue.partNumber());
+            String text = queue.currentPart();
+            assertTrue(text.length() <= FullTranscriptCopyQueue.MAX_PART_LENGTH);
+            assertEquals(text, queue.currentPart());
+            pasted.append(text);
+            assertEquals(part < 3, queue.advance());
+        }
+        assertEquals(transcript, pasted.toString());
+    }
+
+    @Test
+    public void splitKeepsSurrogatePairTogether() {
+        String before = repeated('a', FullTranscriptCopyQueue.MAX_PART_LENGTH - 1);
+        FullTranscriptCopyQueue queue = new FullTranscriptCopyQueue(before + "\uD83D\uDE80tail");
+
+        assertEquals(before, queue.currentPart());
+        assertTrue(queue.advance());
+        assertEquals("\uD83D\uDE80tail", queue.currentPart());
+        assertFalse(queue.advance());
+    }
+
+    @Test
+    public void textAtTheLimitStaysInOnePart() {
+        String transcript = repeated('a', FullTranscriptCopyQueue.MAX_PART_LENGTH);
+        FullTranscriptCopyQueue queue = new FullTranscriptCopyQueue(transcript);
+
+        assertEquals(1, queue.partCount());
+        assertEquals(transcript, queue.currentPart());
+        assertFalse(queue.advance());
+    }
+
+    private static String repeated(char character, int count) {
+        char[] characters = new char[count];
+        Arrays.fill(characters, character);
+        return new String(characters);
+    }
+}
diff --git a/terminal-emulator/src/main/java/com/termux/terminal/TerminalEmulator.java b/terminal-emulator/src/main/java/com/termux/terminal/TerminalEmulator.java
index 5e943ab..4f477f3 100644
--- a/terminal-emulator/src/main/java/com/termux/terminal/TerminalEmulator.java
+++ b/terminal-emulator/src/main/java/com/termux/terminal/TerminalEmulator.java
@@ -3537,8 +3537,74 @@ public final class TerminalEmulator {
         }
     }
 
+    // COPY uses a transcript snapshot at paste-time; terminal output also includes tty echo.
+    private String mCopyPasteSnapshot;
+    private String mCopyPastedText;
+
+    public void markCopiedPaste(String text) {
+        if (text == null || text.trim().isEmpty()) return;
+        mCopyPasteSnapshot = getCopyAllText();
+        mCopyPastedText = text;
+    }
+
+    public String getCopyAllText() {
+        // Use the same extraction as manual selection. Drop the empty rows below the output.
+        String transcript = mMainBuffer.getSelectedText(0, -mMainBuffer.getActiveTranscriptRows(),
+            mMainBuffer.mColumns - 1, mMainBuffer.mScreenRows - 1);
+        int end = transcript.length();
+        while (end > 0 && transcript.charAt(end - 1) == '\n') end--;
+        return transcript.substring(0, end);
+    }
+
+    public String getCopyLastOutput() {
+        if (mCopyPasteSnapshot == null) return null;
+        String current = getCopyAllText();
+        int begin = 0;
+        if (current.startsWith(mCopyPasteSnapshot)) {
+            begin = mCopyPasteSnapshot.length();
+        } else {
+            // Handle rolled-over scrollback as far as overlapping lines allow.
+            int overlap = Math.min(8192, Math.min(mCopyPasteSnapshot.length(), current.length()));
+            while (overlap > 0 &&
+                !mCopyPasteSnapshot.regionMatches(mCopyPasteSnapshot.length() - overlap, current, 0, overlap))
+                overlap--;
+            begin = overlap;
+        }
+        String[] pasted = mCopyPastedText.replace("\r\n", "\n").replace('\r', '\n').split("\n");
+        String[] rows = current.substring(begin).split("\n", -1);
+        int end = rows.length;
+        String finalPrompt = rows[end - 1].trim();
+        if (!finalPrompt.isEmpty() && "$#>%❯".indexOf(finalPrompt.charAt(finalPrompt.length() - 1)) >= 0) {
+            // Empty Enter presses echo the same prompt again without producing output.
+            while (end > 0) {
+                String line = rows[end - 1].trim();
+                if (!line.isEmpty() && !line.equals(finalPrompt)) break;
+                end--;
+            }
+        }
+
+        StringBuilder output = new StringBuilder();
+        for (int i = 0; i < end; i++) {
+            String line = rows[i].trim();
+            boolean isInputEcho = false;
+            for (String original : pasted) {
+                String command = original.trim();
+                if (command.isEmpty() || !line.endsWith(command)) continue;
+                String prompt = line.substring(0, line.length() - command.length()).trim();
+                if (prompt.isEmpty() || "$#>%❯".indexOf(prompt.charAt(prompt.length() - 1)) >= 0) {
+                    isInputEcho = true;
+                    break;
+                }
+            }
+            if (isInputEcho) continue;
+            output.append(rows[i]).append('\n');
+        }
+        return output.toString().trim();
+    }
+
     /** If DECSET 2004 is set, prefix paste with "\033[200~" and suffix with "\033[201~". */
     public void paste(String text) {
+        markCopiedPaste(text);
         // First: Always remove escape key and C1 control characters [0x80,0x9F]:
         text = text.replaceAll("(\u001B|[\u0080-\u009F])", "");
         // Second: Replace all newlines (\n) or CRLF (\r\n) with carriage returns (\r).
