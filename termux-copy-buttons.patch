+++ b/app/src/main/java/com/termux/app/terminal/io/FullTranscriptCopyQueue.java
@@ -0,0 +1,51 @@
+package com.termux.app.terminal.io;
+
+import java.util.ArrayList;
+import java.util.List;
+
+final class FullTranscriptCopyQueue {
+
+    // Leave room below Gboard's 20,000-character clipboard history limit.
+    static final int MAX_PART_LENGTH = 19_000;
+    private static final int LINE_BREAK_LOOKBACK = 256;
+
+    private final List<String> parts = new ArrayList<>();
+    private int partIndex;
+
+    FullTranscriptCopyQueue(String transcript) {
+        for (int start = 0; start < transcript.length();) {
+            int end = start + Math.min(transcript.length() - start, MAX_PART_LENGTH);
+            if (end < transcript.length()) end = chooseBoundary(transcript, end);
+            parts.add(transcript.substring(start, end));
+            start = end;
+        }
+    }
+
+    private static int chooseBoundary(String transcript, int end) {
+        for (int i = end - 1; i >= end - LINE_BREAK_LOOKBACK; i--) {
+            if (transcript.charAt(i) == '\n') return i + 1;
+        }
+        if (Character.isHighSurrogate(transcript.charAt(end - 1))
+                && Character.isLowSurrogate(transcript.charAt(end))) {
+            return end - 1;
+        }
+        return end;
+    }
+
+    String currentPart() {
+        return parts.get(partIndex);
+    }
+
+    int partNumber() {
+        return partIndex + 1;
+    }
+
+    int partCount() {
+        return parts.size();
+    }
+
+    /** Advance after the current part has been written to the clipboard. */
+    boolean advance() {
+        return ++partIndex < parts.size();
+    }
+}
