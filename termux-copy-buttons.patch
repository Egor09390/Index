@@ -105,4 +126,106 @@ public class TermuxTerminalExtraKeys extends TerminalExtraKeys {
         }
     }
 
+    private void copyOrShareTranscript(String key) {
+        TerminalView terminalView = mActivity.getTerminalView();
+        if (terminalView == null || terminalView.mEmulator == null) return;
+
+        TerminalEmulator emulator = terminalView.mEmulator;
+        try {
+            if ("FULL".equals(key)) {
+                copyFullTranscriptPart(emulator);
+                return;
+            }
+
+            boolean copyLastOutput = "COPY".equals(key);
+            String text = copyLastOutput ? emulator.getCopyLastOutput() : emulator.getCopyAllText();
+            if (text == null || text.isEmpty()) {
+                if (!copyLastOutput)
+                    mActivity.showTerminalStatus(mActivity.getString(R.string.msg_no_terminal_transcript), false);
+                return;
+            }
+
+            if ("SHARE-FULL".equals(key)) {
+                Uri uri = TerminalTranscriptFileProvider.writeTranscript(mActivity, text);
+                Intent intent = new Intent(Intent.ACTION_SEND)
+                    .setType(TerminalTranscriptFileProvider.MIME_TYPE)
+                    .putExtra(Intent.EXTRA_STREAM, uri)
+                    .addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
+                mActivity.startActivity(Intent.createChooser(intent, mActivity.getString(R.string.title_share_transcript)));
+            } else {
+                copyTranscript(text);
+                mActivity.showTerminalStatus(mActivity.getString(R.string.msg_terminal_transcript_copied), true);
+            }
+        } catch (IOException | RuntimeException e) {
+            Logger.logStackTraceWithMessage(LOG_TAG, "Could not copy or share the transcript", e);
+            mActivity.showTerminalStatus(mActivity.getString(R.string.msg_terminal_transcript_transfer_failed), true);
+        }
+    }
+
+    private void copyFullTranscriptPart(TerminalEmulator emulator) throws IOException {
+        FullTranscriptCopyQueue queue = mFullCopyQueues.get(emulator);
+        if (queue == null) {
+            String snapshot = emulator.getCopyAllText();
+            if (snapshot.isEmpty()) {
+                mActivity.showTerminalStatus(mActivity.getString(R.string.msg_no_terminal_transcript), false);
+                return;
+            }
+            queue = new FullTranscriptCopyQueue(snapshot);
+            mFullCopyQueues.put(emulator, queue);
+            if (queue.partCount() > 1) saveFullTranscriptToDownloads(snapshot);
+        }
+
+        int part = queue.partNumber();
+        int total = queue.partCount();
+        copyTranscript(queue.currentPart());
+        boolean hasMore = queue.advance();
+        if (!hasMore) mFullCopyQueues.remove(emulator);
+
+        if (total == 1) {
+            mActivity.showTerminalStatus(mActivity.getString(R.string.msg_terminal_transcript_copied), true);
+        } else {
+            int message = hasMore ? R.string.msg_terminal_transcript_part_copied
+                : R.string.msg_terminal_transcript_final_part_copied;
+            mActivity.showTerminalStatus(mActivity.getString(message, part, total), true);
+        }
+    }
+
+    private void saveFullTranscriptToDownloads(String snapshot) {
+        Context context = mActivity.getApplicationContext();
+        DOWNLOADS_EXECUTOR.execute(() -> {
+            String message;
+            try {
+                if (TerminalTranscriptDownloads.canWrite(context)) {
+                    String name = TerminalTranscriptDownloads.save(context, snapshot);
+                    message = context.getString(R.string.msg_terminal_transcript_saved, name);
+                } else {
+                    message = context.getString(R.string.msg_terminal_transcript_storage_permission_needed);
+                }
+            } catch (IOException | RuntimeException e) {
+                Logger.logStackTraceWithMessage(LOG_TAG, "Could not save the transcript in Downloads", e);
+                message = context.getString(R.string.msg_terminal_transcript_save_failed);
+            }
+            String status = message;
+            mActivity.runOnUiThread(() -> mActivity.showTerminalStatus(status, true));
+        });
+    }
+
+    private void copyTranscript(String text) throws IOException {
+        ClipboardManager clipboard = (ClipboardManager) mActivity.getSystemService(Context.CLIPBOARD_SERVICE);
+        if (clipboard == null) throw new IllegalStateException("Clipboard service unavailable");
+
+        String label = mActivity.getString(R.string.title_share_transcript);
+        if (text.length() <= MAX_INLINE_TRANSCRIPT_LENGTH) {
+            try {
+                clipboard.setPrimaryClip(ClipData.newPlainText(label, text));
+                return;
+            } catch (RuntimeException e) {
+                if (!(e.getCause() instanceof TransactionTooLargeException)) throw e;
+            }
+        }
+
+        Uri uri = TerminalTranscriptFileProvider.writeTranscript(mActivity, text);
+        clipboard.setPrimaryClip(ClipData.newUri(mActivity.getContentResolver(), label, uri));
+    }
+
 }
