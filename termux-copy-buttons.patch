@@ -0,0 +1,101 @@
+package com.termux.app.terminal.io;
+
+import android.Manifest;
+import android.content.ContentResolver;
+import android.content.ContentValues;
+import android.content.Context;
+import android.content.pm.PackageManager;
+import android.net.Uri;
+import android.os.Build;
+import android.os.Environment;
+import android.provider.MediaStore;
+
+import androidx.annotation.RequiresApi;
+import androidx.core.content.ContextCompat;
+
+import java.io.BufferedWriter;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.OutputStream;
+import java.io.OutputStreamWriter;
+import java.nio.charset.StandardCharsets;
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.Locale;
+import java.util.UUID;
+
+final class TerminalTranscriptDownloads {
+
+    private TerminalTranscriptDownloads() {}
+
+    static boolean canWrite(Context context) {
+        return Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q
+            || ContextCompat.checkSelfPermission(context, Manifest.permission.WRITE_EXTERNAL_STORAGE)
+                == PackageManager.PERMISSION_GRANTED;
+    }
+
+    static String save(Context context, String transcript) throws IOException {
+        String timestamp = new SimpleDateFormat("yyyyMMdd-HHmmss", Locale.US).format(new Date());
+        String name = "termux-transcript-" + timestamp + "-" + UUID.randomUUID().toString().substring(0, 8) + ".txt";
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
+            saveWithMediaStore(context.getContentResolver(), name, transcript);
+        } else {
+            saveToLegacyDownloads(name, transcript);
+        }
+        return name;
+    }
+
+    @RequiresApi(Build.VERSION_CODES.Q)
+    private static void saveWithMediaStore(ContentResolver resolver, String name, String transcript)
+            throws IOException {
+        ContentValues values = new ContentValues();
+        values.put(MediaStore.Downloads.DISPLAY_NAME, name);
+        values.put(MediaStore.Downloads.MIME_TYPE, TerminalTranscriptFileProvider.MIME_TYPE);
+        values.put(MediaStore.Downloads.RELATIVE_PATH, Environment.DIRECTORY_DOWNLOADS + "/");
+        values.put(MediaStore.Downloads.IS_PENDING, 1);
+
+        Uri file = resolver.insert(MediaStore.Downloads.EXTERNAL_CONTENT_URI, values);
+        if (file == null) throw new IOException("Could not create transcript in Downloads");
+
+        try {
+            OutputStream stream = resolver.openOutputStream(file);
+            if (stream == null) throw new IOException("Could not open transcript for writing");
+            writeText(stream, transcript);
+
+            values.clear();
+            values.put(MediaStore.Downloads.IS_PENDING, 0);
+            if (resolver.update(file, values, null, null) != 1)
+                throw new IOException("Could not publish transcript in Downloads");
+        } catch (IOException | RuntimeException e) {
+            try {
+                resolver.delete(file, null, null);
+            } catch (RuntimeException cleanupError) {
+                e.addSuppressed(cleanupError);
+            }
+            throw e;
+        }
+    }
+
+    @SuppressWarnings("deprecation")
+    private static void saveToLegacyDownloads(String name, String transcript) throws IOException {
+        File downloads = Environment.getExternalStoragePublicDirectory(Environment.DIRECTORY_DOWNLOADS);
+        if (!downloads.isDirectory() && !downloads.mkdirs() && !downloads.isDirectory())
+            throw new IOException("Could not create Downloads directory");
+
+        File temp = File.createTempFile(".termux-transcript-", ".tmp", downloads);
+        try {
+            writeText(new FileOutputStream(temp), transcript);
+            if (!temp.renameTo(new File(downloads, name)))
+                throw new IOException("Could not publish transcript in Downloads");
+        } finally {
+            temp.delete();
+        }
+    }
+
+    private static void writeText(OutputStream stream, String transcript) throws IOException {
+        try (BufferedWriter writer = new BufferedWriter(new OutputStreamWriter(stream, StandardCharsets.UTF_8))) {
+            writer.write(transcript);
+        }
+    }
+}
