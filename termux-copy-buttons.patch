+            if (snapshot.isEmpty()) {
+                mActivity.showTerminalStatus(mActivity.getString(R.string.msg_no_terminal_transcript), false);
+                return;
+            }
+            queue = new FullTranscriptCopyQueue(snapshot);
+            mFullCopyQueues.put(emulator, queue);
+            if (queue.partCount() > 1) saveFullTranscriptToDownloads(snapshot);
+        }
+
+        int part = queue.partNumber();
+        int total = queue.partCount();
+        copyTranscript(queue.currentPart());
+        boolean hasMore = queue.advance();
+        if (!hasMore) mFullCopyQueues.remove(emulator);
+
+        if (total == 1) {
+            mActivity.showTerminalStatus(mActivity.getString(R.string.msg_terminal_transcript_copied), true);
+        } else {
+            int message = hasMore ? R.string.msg_terminal_transcript_part_copied
+                : R.string.msg_terminal_transcript_final_part_copied;
+            mActivity.showTerminalStatus(mActivity.getString(message, part, total), true);
+        }
