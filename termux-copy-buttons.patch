@@ -0,0 +1,51 @@
+package com.termux.app.terminal.io;
+
+import android.content.ClipDescription;
+import android.content.Context;
+import android.net.Uri;
+
+import androidx.annotation.NonNull;
+import androidx.core.content.FileProvider;
+
+import java.io.BufferedWriter;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.OutputStreamWriter;
+import java.nio.charset.StandardCharsets;
+import java.util.concurrent.TimeUnit;
+
+public class TerminalTranscriptFileProvider extends FileProvider {
+
+    static final String MIME_TYPE = "text/plain";
+    private static final String CACHE_SUBDIRECTORY = "terminal-transcripts";
+
+    @Override
+    public String[] getStreamTypes(@NonNull Uri uri, @NonNull String mimeTypeFilter) {
+        return ClipDescription.compareMimeTypes(MIME_TYPE, mimeTypeFilter) ? new String[]{MIME_TYPE} : null;
+    }
+
+    static Uri writeTranscript(Context context, String text) throws IOException {
+        File directory = new File(context.getCacheDir(), CACHE_SUBDIRECTORY);
+        if (!directory.isDirectory() && !directory.mkdir() && !directory.isDirectory()) {
+            throw new IOException("Could not create transcript cache");
+        }
+
+        // Keep recent files available to apps that received a clipboard or share URI.
+        File[] expired = directory.listFiles(file ->
+            file.lastModified() < System.currentTimeMillis() - TimeUnit.DAYS.toMillis(1));
+        if (expired != null) {
+            for (File file : expired) file.delete();
+        }
+
+        File file = File.createTempFile("termux-transcript-", ".txt", directory);
+        try (BufferedWriter writer = new BufferedWriter(new OutputStreamWriter(
+                new FileOutputStream(file), StandardCharsets.UTF_8))) {
+            writer.write(text);
+        } catch (IOException e) {
+            file.delete();
+            throw e;
+        }
+        return getUriForFile(context, context.getPackageName() + ".terminal-transcripts", file);
+    }
+}
