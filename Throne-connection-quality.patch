@@ -0,0 +1,38 @@
+name: Connection quality prerelease
+
+on:
+  push:
+    branches: [throne-connection-quality]
+    paths:
+      - nb4a.properties
+      - .github/workflows/connection-quality.yml
+
+permissions:
+  contents: write
+
+jobs:
+  release:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v7
+      - uses: ./.github/actions/android-build
+        with:
+          tasks: app:testOssDebugUnitTest app:assembleOssDebug
+          channel: preview
+          build-number: '1'
+      - name: Publish APKs as a prerelease
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          set -euo pipefail
+          version=$(sed -n 's/^VERSION_NAME=//p' nb4a.properties)
+          tag="v$version"
+          if gh release view "$tag" >/dev/null 2>&1; then
+            exit 0
+          fi
+          mkdir dist
+          cp app/build/outputs/apk/oss/debug/*.apk dist/
+          (cd dist && sha256sum *.apk > SHA256SUMS)
+          bash buildScript/release_notes.sh "$version" > "$RUNNER_TEMP/quality-release.md"
+          printf '\nTest APKs use the Android debug signing key.\n' >> "$RUNNER_TEMP/quality-release.md"
+          gh release create "$tag" dist/* --target "$GITHUB_SHA" --prerelease --title "Throne $tag" --notes-file "$RUNNER_TEMP/quality-release.md"
