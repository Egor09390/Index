-    private fun peak(): Double {
-        var peak = 0f
-        for (j in 0 until ns) {
-            if (!seriesOn[j]) continue
-            for (b in 0 until nb) {
-                val v = valueAt(b, j)
-                if (v > peak) peak = v
-            }
-        }
-        return peak.toDouble()
-    }
