index 0000000..5285104
--- /dev/null
+++ b/app/src/main/java/io/nekohasekai/sagernet/bg/tproxy/TProxyRootMain.kt
@@ -0,0 +1,192 @@
+package io.nekohasekai.sagernet.bg.tproxy
+
+import android.os.Process
+import android.os.SystemClock
+import android.system.OsConstants
+import io.throneproj.mobile.NetworkInterface as CoreNetworkInterface
+import java.net.NetworkInterface
+import androidx.annotation.Keep
+import io.nekohasekai.sagernet.outbound.json.JsonArray
+import io.nekohasekai.sagernet.outbound.json.JsonInput
+import io.nekohasekai.sagernet.outbound.json.jsonObjectOf
+import io.throneproj.mobile.ConnectionOwner
+import io.throneproj.mobile.InterfaceUpdateListener
+import io.throneproj.mobile.LocalDNSTransport
+import io.throneproj.mobile.LogSink
+import io.throneproj.mobile.Mobile
+import io.throneproj.mobile.NetworkInterfaceIterator
+import io.throneproj.mobile.Notification
+import io.throneproj.mobile.PlatformInterface
+import io.throneproj.mobile.SetupOptions
+import io.throneproj.mobile.StartOptions
+import io.throneproj.mobile.StringIterator
+import io.throneproj.mobile.TunOptions
+import io.throneproj.mobile.WIFIState
+import java.io.File
+import kotlin.concurrent.thread
+import kotlin.system.exitProcess
+
+/** Runs from the installed APK under su. The app keeps stdin open for the lifetime of the session. */
+@Keep
+internal object TProxyRootMain {
+    const val READY = "THRONE_TPROXY_READY"
+    const val ERROR = "THRONE_TPROXY_ERROR"
+    const val LOG = "THRONE_TPROXY_LOG"
+    const val ROOT_DENIED = "root-denied"
+    const val VPN_INTERFACES = "vpn_interfaces"
+
+    @JvmStatic
+    fun main(args: Array<String>) {
+        try {
+            check(Process.myUid() == 0) { ROOT_DENIED }
+            val input = System.`in`.bufferedReader()
+            val options = input.readLine()?.let(JsonInput::parseObject) ?: return
+            val setupStartedAt = SystemClock.elapsedRealtime()
+            val uid = options.int("uid")
+            val port = options.int("port")
+            val target = options.obj("target")
+            check(uid > 0 && port in 1024..65535 && target.int("server_port") in 1..65535)
+            check(target.string("server") == "127.0.0.1")
+            val workDir = File(options.string("work_dir"))
+            check(workDir.isAbsolute && workDir.isDirectory && workDir.canWrite()) {
+                "The TPROXY cache directory is not writable"
+            }
+            // The root process has its own core and does not inherit the app's Mobile.setup().
+            val path = workDir.absolutePath
+            Mobile.setup(SetupOptions().apply {
+                basePath = path
+                workingPath = path
+                tempPath = path
+            })
+            Mobile.setLogSink(object : LogSink {
+                override fun write(level: Int, message: String) {
+                    if (level <= Mobile.LogLevelWarn) {
+                        println("$LOG ${message.lineSequence().first().take(400)}")
+                    }
+                }
+            })
+            target["type"] = "socks"
+            target["tag"] = "throne"
+            target["version"] = "5"
+
+            val inbounds = JsonArray()
+            for ((name, address) in listOf("ipv4" to "127.0.0.1", "ipv6" to "::1")) {
+                inbounds.add(jsonObjectOf("type" to "tproxy", "tag" to name, "listen" to address, "listen_port" to port))
+            }
+            val rejectLoopback = jsonObjectOf(
+                "ip_cidr" to JsonArray.of("127.0.0.0/8", "::1/128", "::ffff:127.0.0.0/104"),
+                "action" to "reject",
+            )
+            val config = jsonObjectOf(
+                "log" to jsonObjectOf("level" to "warn"),
+                "certificate" to jsonObjectOf("store" to "none"),
+                "inbounds" to inbounds,
+                "outbounds" to JsonArray.of(target),
+                "route" to jsonObjectOf("rules" to JsonArray.of(rejectLoopback), "final" to "throne"),
+            )
+            val loopback = checkNotNull(NetworkInterface.getByName("lo")) { "Loopback interface is unavailable" }
+            val box = Mobile.newInstance(Platform(loopback), StartOptions().apply { coreConfig = config.toCompact() })
+            try {
+                box.start()
+                val vpnUids = options.array("vpn_uids").map { (it as Number).toInt() }.toSet()
+                val routes = TProxyRoutes(uid, port, options.array("bypass_ranges").strings(), vpnUids) { run(it) }
+                val cleanup = Thread { runCatching { routes.close() } }
+                Runtime.getRuntime().addShutdownHook(cleanup)
+                try {
+                    val vpnInterfaces = options.array(VPN_INTERFACES).strings().toSet()
+                    val rulesStartedAt = SystemClock.elapsedRealtime()
+                    var batches = 0
+                    routes.start(options.bool("reject_quic"), vpnInterfaces, restore = { command, input ->
+                        try {
+                            run(command, input)
+                            batches++
+                        } catch (error: Exception) {
+                            println("$LOG Firewall batch unavailable for ${command.first().substringAfterLast('/')}")
+                            throw error
+                        }
+                    }) { error ->
+                        println("$LOG QUIC rejection unavailable: ${error.message?.lineSequence()?.firstOrNull().orEmpty()}")
+                    }
+                    println("$LOG Startup relay=${rulesStartedAt - setupStartedAt}ms firewall=${SystemClock.elapsedRealtime() - rulesStartedAt}ms batches=$batches/2")
+                    println("$LOG VPN client UIDs excluded from interception: ${vpnUids.size}")
+                    println("$LOG Android VPN egress interfaces: ${vpnInterfaces.joinToString().ifEmpty { "none" }}")
+                    println(READY)
+                    // EOF ends the session, including when the app dies.
+                    while (true) {
+                        val command = input.readLine()?.let(JsonInput::parseObject) ?: break
+                        check(command.isArray(VPN_INTERFACES)) { "Invalid TPROXY control message" }
+                        val nextInterfaces = command.array(VPN_INTERFACES).strings().toSet()
+                        if (routes.setAndroidVpnInterfaces(nextInterfaces)) {
+                            println("$LOG Android VPN egress interfaces: ${nextInterfaces.joinToString().ifEmpty { "none" }}")
+                            box.resetNetwork()
+                        }
+                    }
+                } finally {
+                    runCatching { routes.packetCounts { command -> run(command) } }.onSuccess { println("$LOG $it") }
+                    routes.close()
+                    Runtime.getRuntime().removeShutdownHook(cleanup)
+                }
+            } finally {
+                // Rules have been removed. A slow native close must not keep the root process alive.
+                val shutdown = thread(name = "TPROXY core close", isDaemon = true) {
+                    runCatching { box.close() }.onFailure {
+                        println("$LOG Core close failed")
+                    }
+                }
+                shutdown.join(5_000)
+                if (shutdown.isAlive) println("$LOG Core close timed out")
+            }
+        } catch (error: Throwable) {
+            // Do not print the session config or the mixed inbound's credentials.
+            val message = (error.message ?: error.javaClass.simpleName).lineSequence().first().take(400)
+            println("$ERROR $message")
+            exitProcess(1)
+        }
+        // JNI can leave attached threads after main() returns.
+        exitProcess(0)
+    }
+
+    private fun run(command: List<String>, input: String? = null): String {
+        val process = ProcessBuilder(command).redirectErrorStream(true).start()
+        process.outputStream.use { stream ->
+            if (input != null) stream.write(input.toByteArray(Charsets.UTF_8))
+        }
+        val output = process.inputStream.bufferedReader().use { it.readText().trim() }
+        if (process.waitFor() != 0) {
+            val name = command.first().substringAfterLast('/')
+            error("$name: ${output.ifBlank { "command failed" }}")
+        }
+        return output
+    }
+
+    // The root core only listens on loopback and dials a numeric loopback address in the unprivileged core.
+    private class Platform(private val loopback: NetworkInterface) : PlatformInterface {
+        override fun localDNSTransport(): LocalDNSTransport? = null
+        override fun usePlatformAutoDetectInterfaceControl() = false
+        override fun autoDetectInterfaceControl(fd: Int) = Unit
+        override fun openTun(options: TunOptions): Int = error("No TUN in TPROXY")
+        override fun useProcFS() = false
+        override fun findConnectionOwner(ipProtocol: Int, sourceAddress: String, sourcePort: Int, destinationAddress: String, destinationPort: Int): ConnectionOwner =
+            error("Connection lookup unavailable")
+        override fun packageNamesByUid(uid: Int): StringIterator? = null
+        override fun startDefaultInterfaceMonitor(listener: InterfaceUpdateListener) {
+            listener.updateDefaultInterface(loopback.name, loopback.index, false, false)
+        }
+        override fun closeDefaultInterfaceMonitor(listener: InterfaceUpdateListener) = Unit
+        override fun getInterfaces(): NetworkInterfaceIterator {
+            val interfaces = listOf(CoreNetworkInterface().apply {
+                name = loopback.name
+                index = loopback.index
+                flags = OsConstants.IFF_UP or OsConstants.IFF_RUNNING or OsConstants.IFF_LOOPBACK
+            }).iterator()
+            return object : NetworkInterfaceIterator {
+                override fun hasNext() = interfaces.hasNext()
+                override fun next(): CoreNetworkInterface = interfaces.next()
+            }
+        }
+        override fun readWIFIState(): WIFIState? = null
+        override fun clearDNSCache() = Unit
+        override fun sendNotification(notification: Notification) = Unit
+        override fun cancelNotification(identifier: String, typeID: Int) = Unit
+    }
+}
diff --git a/app/src/main/java/io/nekohasekai/sagernet/bg/tproxy/TProxyRoutes.kt b/app/src/main/java/io/nekohasekai/sagernet/bg/tproxy/TProxyRoutes.kt
new file mode 100644
index 0000000..7b45d10
--- /dev/null
+++ b/app/src/main/java/io/nekohasekai/sagernet/bg/tproxy/TProxyRoutes.kt
@@ -0,0 +1,220 @@
+package io.nekohasekai.sagernet.bg.tproxy
+
+import java.io.Closeable
+
+/** Owns only this session's policy rules, routes and mangle chains. */
+internal class TProxyRoutes(
+    private val uid: Int,
+    private val port: Int,
+    private val bypassRanges: List<String>,
+    private val vpnUids: Set<Int>,
+    private val run: (List<String>) -> Unit,
+) : Closeable {
+    private val undo = ArrayDeque<List<String>>()
+    private val output = "THRONE_TPROXY_OUT"
+    private val prerouting = "THRONE_TPROXY_IN"
+    private val table = (100_000L + uid).toString()
+    private var vpnInterfaces = emptySet<String>()
+
+    private data class Family(
+        val selector: String,
+        val firewall: String,
+        val localhost: String,
+        val multicast: String,
+        val defaultRoute: String,
+    ) {
+        fun firewall(vararg args: String) = listOf("/system/bin/$firewall", "-w", "2", "-t", "mangle") + args
+        fun ip(vararg args: String) = listOf("/system/bin/ip", selector) + args
+    }
+
+    private val families = listOf(
+        Family("-4", "iptables", "127.0.0.1", "224.0.0.0/4", "0.0.0.0/0"),
+        Family("-6", "ip6tables", "::1", "ff00::/8", "::/0"),
+    )
+
+    @Synchronized
+    fun start(
+        rejectQuic: Boolean = false,
+        androidVpnInterfaces: Set<String> = emptySet(),
+        restore: ((List<String>, String) -> Unit)? = null,
+        onQuicRuleError: (Exception) -> Unit = {},
+    ) {
+        check(undo.isEmpty())
+        vpnInterfaces = checkedVpnInterfaces(androidVpnInterfaces)
+        try {
+            for (family in families) prepare(family, restore)
+            for (family in families) {
+                hook(family, "PREROUTING", "-i", "lo", "-m", "mark", "--mark", MARK, "-j", prerouting)
+            }
+            if (rejectQuic) {
+                for (family in families) {
+                    try {
+                        installQuicRejection(family)
+                    } catch (error: Exception) {
+                        onQuicRuleError(error)
+                    }
+                }
+            }
+            for (family in families) hook(family, "OUTPUT", "-j", output)
+        } catch (error: Throwable) {
+            runCatching { close() }.exceptionOrNull()?.let(error::addSuppressed)
+            throw error
+        }
+    }
+
+    private fun prepare(family: Family, restore: ((List<String>, String) -> Unit)?) {
+        val chains = listOf(output, prerouting)
+        val rules = chainRules(family)
+        val commands = chains.map { listOf("-N", it) } + rules
+        // The restore parser reads text, unlike ProcessBuilder's argument list. Use it only for plain tokens
+        // and only one table/commit, so a rejected batch can safely fall back to individual commands.
+        val restored = if (restore != null && commands.all { command -> command.all(RESTORE_TOKEN::matches) }) {
+            val input = commands.joinToString("\n", prefix = "*mangle\n", postfix = "\nCOMMIT\n") { it.joinToString(" ") }
+            try {
+                restore(listOf("/system/bin/${family.firewall}-restore", "-w", "2", "--noflush"), input)
+                true
+            } catch (_: Exception) {
+                false
+            }
+        } else {
+            false
+        }
+        for (chain in chains) {
+            if (!restored) run(family.firewall("-N", chain))
+            undo.addLast(family.firewall("-X", chain))
+            undo.addLast(family.firewall("-F", chain))
+        }
+        val route = arrayOf("local", family.defaultRoute, "dev", "lo", "table", table)
+        apply(family.ip("route", "add", *route), family.ip("route", "del", *route))
+        val rule = arrayOf("pref", PRIORITY, "fwmark", MARK, "lookup", table)
+        apply(family.ip("rule", "add", *rule), family.ip("rule", "del", *rule))
+
+        if (!restored) rules.forEach { run(family.firewall(*it.toTypedArray())) }
+    }
+
+    private fun chainRules(family: Family): List<List<String>> = buildList {
+        fun outputRule(vararg args: String) {
+            add(listOf("-A", output) + args)
+        }
+        outputRule("-o", "lo", "-j", "RETURN")
+        for (name in vpnInterfaces) {
+            outputRule("-o", name, "-j", "RETURN")
+        }
+        outputRule("-m", "owner", "--uid-owner", "0", "-j", "RETURN")
+        outputRule("-m", "owner", "--uid-owner", uid.toString(), "-j", "RETURN")
+        // A VPN client can contact its server before calling protect() or establishing a VPN.
+        for (vpnUid in vpnUids) {
+            outputRule("-m", "owner", "--uid-owner", vpnUid.toString(), "-j", "RETURN")
+        }
+        // VpnService.protect() marks the VPN's transport sockets. Reinjecting them would loop.
+        outputRule("-m", "mark", "--mark", ANDROID_VPN_PROTECTED, "-j", "RETURN")
+        outputRule("-d", family.multicast, "-j", "RETURN")
+        if (family.selector == "-4") outputRule("-d", "255.255.255.255/32", "-j", "RETURN")
+
+        // Replies from a transparent socket must not enter the listener again.
+        add(listOf("-A", prerouting, "-m", "conntrack", "--ctdir", "REPLY", "-j", "RETURN"))
+
+        // DNS to a LAN resolver still reaches Throne's DNS route before the LAN exclusions.
+        for (protocol in listOf("tcp", "udp")) {
+            outputRule("-p", protocol, "--dport", "53", "-j", "MARK", "--set-xmark", MARK)
+        }
+        outputRule("-m", "mark", "--mark", MARK, "-j", "RETURN")
+        for (range in bypassRanges) {
+            if (range.contains(':') == (family.selector == "-6")) outputRule("-d", range, "-j", "RETURN")
+        }
+        for (protocol in listOf("tcp", "udp")) {
+            outputRule("-p", protocol, "-j", "MARK", "--set-xmark", MARK)
+            add(listOf(
+                "-A", prerouting, "-p", protocol, "-j", "TPROXY",
+                "--on-ip", family.localhost, "--on-port", port.toString(), "--tproxy-mark", MARK,
+            ))
+        }
+    }
+
+    @Synchronized
+    fun setAndroidVpnInterfaces(names: Set<String>): Boolean {
+        check(undo.isNotEmpty())
+        val next = checkedVpnInterfaces(names)
+        if (next == vpnInterfaces) return false
+        val added = next - vpnInterfaces
+        val removed = vpnInterfaces - next
+        for (family in families) {
+            // OUTPUT already has Android's chosen egress. Leave its VPN-bound packets unmarked,
+            // including DNS and QUIC, so Android's per-app and per-destination VPN policy applies.
+            for (name in added) run(family.firewall("-I", output, "1", "-o", name, "-j", "RETURN"))
+        }
+        for (family in families) {
+            for (name in removed) run(family.firewall("-D", output, "-o", name, "-j", "RETURN"))
+        }
+        vpnInterfaces = next
+        return true
+    }
+
+    private fun checkedVpnInterfaces(names: Set<String>): Set<String> {
+        require(names.all { it != "lo" && INTERFACE_NAME.matches(it) }) { "Invalid Android VPN interface" }
+        return names.toSortedSet()
+    }
+
+    private fun installQuicRejection(family: Family) {
+        // The filter OUTPUT hook runs after mangle OUTPUT. Only marked, intercepted packets match;
+        // the VPN transport, local sockets and exempt applications keep their own UDP path.
+        val args = listOf(
+            "-m", "mark", "--mark", MARK, "-p", "udp", "--dport", "443",
+            "-j", "REJECT", "--reject-with",
+            if (family.selector == "-4") "icmp-port-unreachable" else "icmp6-port-unreachable",
+        )
+        val command = listOf("/system/bin/${family.firewall}", "-w", "2", "-t", "filter")
+        apply(command + listOf("-I", "OUTPUT", "1") + args, command + listOf("-D", "OUTPUT") + args)
+    }
+
+    /** Report counts from our own rules and omit addresses and packet data. */
+    fun packetCounts(query: (List<String>) -> String): String = families.joinToString(
+        prefix = "Packets intercepted by TPROXY: ",
+    ) { family ->
+        val listing = query(family.firewall("-L", prerouting, "-n", "-v", "-x"))
+        val counts = listing.lineSequence().mapNotNull { line ->
+            val fields = line.trim().split(WHITESPACE, limit = 5)
+            if (fields.getOrNull(2) == "TPROXY") {
+                val protocol = fields.getOrNull(3)
+                val count = fields.firstOrNull()?.toLongOrNull()
+                if (protocol != null && count != null) "$protocol=$count" else null
+            } else null
+        }.toList()
+        "IPv${family.selector.last()} ${counts.joinToString(" ")}"
+    }
+
+    private fun hook(family: Family, chain: String, vararg rule: String) {
+        apply(family.firewall("-I", chain, "1", *rule), family.firewall("-D", chain, *rule))
+    }
+
+    private fun apply(command: List<String>, remove: List<String>) {
+        run(command)
+        undo.addLast(remove)
+    }
+
+    @Synchronized
+    override fun close() {
+        var failure: Throwable? = null
+        val failedCommands = ArrayDeque<List<String>>()
+        while (undo.isNotEmpty()) {
+            val command = undo.removeLast()
+            try {
+                run(command)
+            } catch (error: Throwable) {
+                failedCommands.addFirst(command)
+                if (failure == null) failure = error else failure.addSuppressed(error)
+            }
+        }
+        undo.addAll(failedCommands)
+        failure?.let { throw it }
+    }
+
+    private companion object {
+        val WHITESPACE = Regex("\\s+")
+        const val MARK = "0x10000000/0x10000000"
+        const val ANDROID_VPN_PROTECTED = "0x00020000/0x00020000"
+        const val PRIORITY = "9000"
+        val INTERFACE_NAME = Regex("[A-Za-z0-9_.-]{1,15}")
+        val RESTORE_TOKEN = Regex("[A-Za-z0-9_.:/-]+")
+    }
+}
diff --git a/app/src/main/java/io/nekohasekai/sagernet/bg/tproxy/TProxySession.kt b/app/src/main/java/io/nekohasekai/sagernet/bg/tproxy/TProxySession.kt
new file mode 100644
index 0000000..4df5ca9
--- /dev/null
+++ b/app/src/main/java/io/nekohasekai/sagernet/bg/tproxy/TProxySession.kt
@@ -0,0 +1,176 @@
+package io.nekohasekai.sagernet.bg.tproxy
+
+import android.Manifest
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.net.VpnService
+import android.os.Process
+import io.nekohasekai.sagernet.R
+import io.nekohasekai.sagernet.database.DataStore
+import io.nekohasekai.sagernet.outbound.config.PortLease
+import io.nekohasekai.sagernet.outbound.json.JsonArray
+import io.nekohasekai.sagernet.outbound.json.JsonInput
+import io.nekohasekai.sagernet.outbound.json.JsonObject
+import io.nekohasekai.sagernet.outbound.json.JsonValues
+import io.nekohasekai.sagernet.outbound.json.jsonObjectOf
+import java.io.Closeable
+import java.io.IOException
+import java.io.File
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+import kotlin.concurrent.thread
+import moe.matsuri.nb4a.utils.CoreLog
+
+internal class TProxySession(
+    private val context: Context,
+    private val onUnexpectedStop: () -> Unit,
+) : Closeable {
+    private val ready = CountDownLatch(1)
+    private val stopped = CountDownLatch(1)
+    private val ports = PortLease()
+    @Volatile private var process: java.lang.Process? = null
+
+    @Volatile private var connected = false
+    @Volatile private var closing = false
+    @Volatile private var errorMessage: String? = null
+
+    private val commands = Any()
+    private var vpnInterfaces = emptySet<String>()
+
+    /** Start su and the JVM while the main core is being prepared. The child waits for its config. */
+    fun prepareRootProcess() {
+        check(process == null && !closing)
+        val appInfo = context.applicationInfo
+        val abiRuntime = if (Process.is64Bit()) "/system/bin/app_process64" else "/system/bin/app_process32"
+        val runtime = if (File(abiRuntime).canExecute()) abiRuntime else "/system/bin/app_process"
+        val command = "export CLASSPATH=${quote(appInfo.sourceDir)} LD_LIBRARY_PATH=${quote(appInfo.nativeLibraryDir)}; " +
+            "exec $runtime /system/bin ${TProxyRootMain::class.java.name}"
+        val child = try {
+            ProcessBuilder("su", "-c", command).redirectErrorStream(true).start()
+        } catch (_: IOException) {
+            error(context.getString(R.string.tproxy_root_denied))
+        }
+        process = child
+        thread(name = "TPROXY root process", isDaemon = true) {
+            try {
+                child.inputStream.bufferedReader().useLines { lines ->
+                    for (line in lines) {
+                        when {
+                            line == TProxyRootMain.READY -> {
+                                connected = true
+                                ready.countDown()
+                            }
+                            line.startsWith("${TProxyRootMain.ERROR} ") -> {
+                                errorMessage = line.substringAfter(' ').take(400)
+                            }
+                            line.startsWith("${TProxyRootMain.LOG} ") -> {
+                                CoreLog.write("[TPROXY] ${line.substringAfter(' ')}")
+                            }
+                        }
+                    }
+                }
+            } finally {
+                stopped.countDown()
+                ready.countDown()
+                if (connected && !closing) onUnexpectedStop()
+            }
+        }
+    }
+
+    fun start(coreConfig: String, initialVpnInterfaces: Set<String>) {
+        val config = JsonInput.parseObject(coreConfig)
+        val mixed = config.array("inbounds")
+            .mapNotNull { it as? JsonObject }
+            .firstOrNull { it.string("type") == "mixed" && it.string("tag") == "mixed-in" }
+        if (mixed == null || mixed.string("listen") !in listOf("127.0.0.1", "::", "0.0.0.0") ||
+            mixed.int("listen_port") !in 1..65535) {
+            error(context.getString(R.string.tproxy_no_ingress))
+        }
+
+        val target = jsonObjectOf("server" to "127.0.0.1", "server_port" to mixed.int("listen_port"))
+        (mixed.array("users").firstOrNull() as? JsonObject)?.let {
+            target["username"] = it.string("username")
+            target["password"] = it.string("password")
+        }
+        val port = ports.reserve(1).single()
+        check(port >= 1024)
+        val bypass = JsonArray()
+        if (!DataStore.disablePrivateRangeBypass) DataStore.vpnPrivateRanges.forEach { bypass.add(it) }
+        // These are interface-local even when the user includes private unicast networks in the proxy.
+        bypass.add("169.254.0.0/16")
+        bypass.add("fe80::/10")
+        val workDir = File(context.cacheDir, "tproxy")
+        check(workDir.isDirectory || workDir.mkdirs()) { "Cannot create the TPROXY cache directory" }
+        val vpnUids = vpnClientUids()
+        val options = jsonObjectOf(
+            "uid" to Process.myUid(), "port" to port, "target" to target, "bypass_ranges" to bypass,
+            "vpn_uids" to JsonArray().apply { vpnUids.forEach { add(it) } },
+            "reject_quic" to requiresQuicFallback(config),
+            TProxyRootMain.VPN_INTERFACES to JsonValues.stringArray(initialVpnInterfaces.sorted()),
+            "work_dir" to workDir.absolutePath,
+        )
+
+        val child = checkNotNull(process)
+        try {
+            synchronized(commands) {
+                check(!closing)
+                send(child, options)
+                vpnInterfaces = initialVpnInterfaces
+            }
+        } catch (_: IOException) {
+            error(context.getString(R.string.tproxy_root_denied))
+        }
+        if (!ready.await(30, TimeUnit.SECONDS)) error(context.getString(R.string.tproxy_root_timeout))
+        if (!connected || stopped.count == 0L) {
+            val message = errorMessage?.takeUnless { it == TProxyRootMain.ROOT_DENIED }
+                ?: context.getString(R.string.tproxy_root_denied)
+            error(context.getString(R.string.tproxy_start_failed, message))
+        }
+    }
+
+    // Query before installing OUTPUT hooks so a VPN can start even when there is no VPN network yet.
+    @Suppress("DEPRECATION")
+    private fun vpnClientUids(): Set<Int> = context.packageManager.queryIntentServices(
+        Intent(VpnService.SERVICE_INTERFACE),
+        PackageManager.MATCH_DISABLED_COMPONENTS,
+    ).mapNotNull { result ->
+        val service = result.serviceInfo ?: return@mapNotNull null
+        val uid = service.applicationInfo?.uid ?: return@mapNotNull null
+        uid.takeIf { service.permission == Manifest.permission.BIND_VPN_SERVICE && it > 0 && it != Process.myUid() }
+    }.toSortedSet()
+
+    fun setAndroidVpnInterfaces(names: Set<String>): Boolean = synchronized(commands) {
+        val child = process ?: return false
+        if (closing || !connected || names == vpnInterfaces) return false
+        send(child, jsonObjectOf(TProxyRootMain.VPN_INTERFACES to JsonValues.stringArray(names.sorted())))
+        vpnInterfaces = names
+        true
+    }
+
+    private fun send(child: java.lang.Process, command: JsonObject) {
+        child.outputStream.write((command.toCompact() + "\n").toByteArray(Charsets.UTF_8))
+        child.outputStream.flush()
+    }
+
+    fun requestStop() {
+        closing = true
+        synchronized(commands) {
+            runCatching { process?.outputStream?.close() }
+        }
+    }
+
+    override fun close() {
+        requestStop()
+        try {
+            if (process != null && !stopped.await(15, TimeUnit.SECONDS)) {
+                error(context.getString(R.string.tproxy_stop_timeout))
+            }
+            if (connected) errorMessage?.let { error(context.getString(R.string.tproxy_start_failed, it)) }
+        } finally {
+            ports.close()
+        }
+    }
+
+    private fun quote(value: String): String = "'" + value.replace("'", "'\"'\"'") + "'"
+}
